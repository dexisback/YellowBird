PORT=3000
DATABASE_URL=postgres://postgres:YOUR_RDS_PASSWORD@YOUR_RDS_ENDPOINT:5432/postgres?sslmode=require

JWT_SECRET=your_jwt_secret_key_change_me_in_production

REDIS_ADDR=redis:6379
REDIS_PASSWORD=
REDIS_DB=0

# Storage Provider: "s3" or "cloudinary"
STORAGE_PROVIDER=s3
S3_BUCKET=yellowbird-media-prod
S3_REGION=us-east-1
# AWS credentials (leave empty to use IAM Task Role in ECS Fargate / EC2 Instance Profile)
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# S3_ENDPOINT=

# Legacy Cloudinary fallback
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret

WORKER_CONCURRENCY=4

