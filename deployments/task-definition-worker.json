{
  "family": "yellowbird-worker",
  "networkMode": "awsvpc",
  "requiresCompatibilities": [
    "FARGATE"
  ],
  "cpu": "1024",
  "memory": "2048",
  "executionRoleArn": "arn:aws:iam::056126811138:role/yellowbird-ecs-exec-role",
  "taskRoleArn": "arn:aws:iam::056126811138:role/yellowbird-ecs-task-role",
  "containerDefinitions": [
    {
      "name": "yellowbird-worker-container",
      "image": "056126811138.dkr.ecr.us-east-1.amazonaws.com/yellowbird-worker:latest",
      "essential": true,
      "portMappings": [],
      "environment": [
        { "name": "APP_ENV", "value": "production" },
        { "name": "STORAGE_PROVIDER", "value": "s3" },
        { "name": "S3_BUCKET", "value": "yellowbird-media-amaan" },
        { "name": "S3_REGION", "value": "us-east-1" },
        { "name": "WORKER_CONCURRENCY", "value": "4" },
        { "name": "REDIS_ADDR", "value": "chief-aardvark-159591.upstash.io:6379" },
        { "name": "REDIS_DB", "value": "0" }
      ],
      "secrets": [
        {
          "name": "DATABASE_URL",
          "valueFrom": "arn:aws:ssm:us-east-1:056126811138:parameter/yellowbird/production/database-url"
        },
        {
          "name": "REDIS_PASSWORD",
          "valueFrom": "arn:aws:ssm:us-east-1:056126811138:parameter/yellowbird/production/redis-password"
        },
        {
          "name": "JWT_SECRET",
          "valueFrom": "arn:aws:ssm:us-east-1:056126811138:parameter/yellowbird/production/jwt-secret"
        }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/yellowbird-worker",
          "awslogs-region": "us-east-1",
          "awslogs-stream-prefix": "ecs",
          "awslogs-create-group": "true"
        }
      }
    }
  ]
}